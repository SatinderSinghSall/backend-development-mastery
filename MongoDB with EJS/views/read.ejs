<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f8ff" />
    <title>Users | Nexus Dashboard</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      .glass-panel {
        background: rgba(255, 255, 255, 0.86);
        border: 1px solid rgba(255, 255, 255, 0.95);
        box-shadow: 0 10px 40px rgba(32, 55, 110, 0.045);
        backdrop-filter: blur(16px);
      }

      .user-card {
        animation: fade-up 0.45s ease both;
      }

      .user-card:hover .profile-image {
        transform: scale(1.06);
      }

      .profile-image {
        transition: transform 0.55s ease;
      }

      .search-box:focus-within {
        border-color: #93aefb;
        box-shadow: 0 0 0 4px rgba(79, 114, 247, 0.09);
        background: #fff;
      }

      .soft-button {
        transition: all 0.2s ease;
      }

      .soft-button:hover {
        transform: translateY(-1px);
      }

      @keyframes fade-up {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>

  <body class="min-h-screen bg-[#f7f8fc] text-slate-800">
    <!-- Background -->
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div
        class="absolute -left-40 -top-40 h-[420px] w-[420px] rounded-full bg-blue-200/35 blur-[100px]"
      ></div>
      <div
        class="absolute -right-32 top-10 h-[420px] w-[420px] rounded-full bg-violet-200/30 blur-[100px]"
      ></div>
      <div
        class="absolute bottom-0 left-1/3 h-80 w-80 rounded-full bg-cyan-100/40 blur-[100px]"
      ></div>
    </div>

    <main
      class="mx-auto max-w-[1440px] px-4 py-6 sm:px-7 sm:py-9 lg:px-10 lg:py-12"
    >
      <!-- Top navigation -->
      <nav class="mb-10 flex items-center justify-between">
        <a href="/read-user" class="flex items-center gap-3">
          <div
            class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-600 text-white shadow-lg shadow-blue-600/20"
          >
            <i class="fa-solid fa-layer-group text-lg"></i>
          </div>

          <div>
            <p class="text-base font-extrabold tracking-tight text-slate-900">
              Nexus<span class="text-blue-600">.</span>
            </p>
            <p class="text-[11px] font-medium tracking-wide text-slate-400">
              USER MANAGEMENT
            </p>
          </div>
        </a>

        <div
          class="hidden items-center gap-2 rounded-full border border-emerald-100 bg-white/80 px-3.5 py-2 sm:flex"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-50"
            ></span>
            <span
              class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"
            ></span>
          </span>
          <span class="text-xs font-semibold text-slate-600"
            >Dashboard ready</span
          >
        </div>
      </nav>

      <!-- Page heading -->
      <header
        class="mb-8 flex flex-col justify-between gap-6 md:flex-row md:items-end"
      >
        <div>
          <div
            class="mb-4 inline-flex items-center gap-2 rounded-full border border-blue-100 bg-blue-50/80 px-3 py-1.5 text-xs font-bold text-blue-700"
          >
            <i class="fa-solid fa-users text-[11px]"></i>
            YOUR PEOPLE, ALL IN ONE PLACE
          </div>

          <h1
            class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-[42px]"
          >
            All users<span class="text-blue-600">.</span>
          </h1>

          <p
            class="mt-3 max-w-xl text-sm leading-6 text-slate-500 sm:text-base"
          >
            A clear view of your community. Find profiles, update details, and
            manage your users effortlessly.
          </p>
        </div>

        <a
          href="/create-user"
          class="soft-button inline-flex items-center justify-center gap-2.5 self-start rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-600 px-5 py-3.5 text-sm font-bold text-white shadow-lg shadow-blue-600/20 hover:from-blue-700 hover:to-indigo-700 md:self-auto"
        >
          <i class="fa-solid fa-plus"></i>
          Add new user
          <i class="fa-solid fa-arrow-right ml-1 text-xs opacity-80"></i>
        </a>
      </header>

      <!-- Dashboard stats -->
      <section class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="glass-panel flex items-center gap-4 rounded-2xl p-5 sm:p-6">
          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-blue-50 text-blue-600"
          >
            <i class="fa-solid fa-users text-lg"></i>
          </div>
          <div>
            <p class="text-sm font-medium text-slate-500">Total users</p>
            <div class="mt-1 flex items-center gap-2">
              <p class="text-2xl font-extrabold tracking-tight text-slate-900">
                <%= users.length %>
              </p>
              <span
                class="rounded-lg bg-blue-50 px-2 py-1 text-[10px] font-bold text-blue-700"
                >ALL TIME</span
              >
            </div>
          </div>
        </div>

        <div class="glass-panel flex items-center gap-4 rounded-2xl p-5 sm:p-6">
          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600"
          >
            <i class="fa-solid fa-user-check text-lg"></i>
          </div>
          <div>
            <p class="text-sm font-medium text-slate-500">Profiles available</p>
            <p
              class="mt-1 text-2xl font-extrabold tracking-tight text-slate-900"
            >
              <%= users.length %>
            </p>
          </div>
        </div>

        <div class="glass-panel flex items-center gap-4 rounded-2xl p-5 sm:p-6">
          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-violet-50 text-violet-600"
          >
            <i class="fa-solid fa-shield-halved text-lg"></i>
          </div>
          <div>
            <p class="text-sm font-medium text-slate-500">Workspace</p>
            <p
              class="mt-1 text-lg font-extrabold tracking-tight text-slate-900"
            >
              User directory
            </p>
          </div>
        </div>
      </section>

      <!-- Directory panel -->
      <section class="glass-panel overflow-hidden rounded-3xl">
        <!-- Toolbar -->
        <div
          class="flex flex-col gap-5 border-b border-slate-100 p-5 sm:p-7 lg:flex-row lg:items-center lg:justify-between"
        >
          <div>
            <div class="flex flex-wrap items-center gap-3">
              <h2 class="text-lg font-extrabold text-slate-900">
                User directory
              </h2>
              <span
                class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-600"
              >
                <%= users.length %> records
              </span>
            </div>
            <p class="mt-1.5 text-sm text-slate-400">
              Browse and manage registered profiles.
            </p>
          </div>

          <div
            class="search-box flex w-full items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50/80 px-4 py-3 transition lg:max-w-md"
          >
            <i class="fa-solid fa-magnifying-glass text-sm text-slate-400"></i>
            <input
              id="userSearch"
              type="search"
              placeholder="Search name or email..."
              aria-label="Search users by name or email"
              class="w-full bg-transparent text-sm text-slate-700 outline-none placeholder:text-slate-400"
            />
            <kbd
              class="hidden rounded-md border border-slate-200 bg-white px-2 py-1 text-[10px] font-semibold text-slate-400 sm:inline-block"
              >SEARCH</kbd
            >
          </div>
        </div>

        <!-- User grid -->
        <div class="p-5 sm:p-7">
          <% if (users.length > 0) { %>

          <div
            id="userGrid"
            class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4"
          >
            <% users.forEach((user, index) => { %>

            <article
              class="user-card group overflow-hidden rounded-2xl border border-slate-100 bg-white transition duration-300 hover:-translate-y-1 hover:border-blue-100 hover:shadow-xl hover:shadow-blue-950/[0.06]"
              data-name="<%= user.name || '' %>"
              data-email="<%= user.email || '' %>"
              style="animation-delay: <%= Math.min(index * 50, 300) %>ms"
            >
              <!-- Image -->
              <div
                class="relative h-48 overflow-hidden bg-gradient-to-br from-blue-50 via-indigo-50 to-violet-100"
              >
                <img
                  src="<%= user.image || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name || 'User') + '&background=e0e7ff&color=3730a3&size=400') %>"
                  alt="Profile of <%= user.name || 'User' %>"
                  loading="lazy"
                  class="profile-image h-full w-full object-cover"
                  onerror="
                    this.onerror = null;
                    this.src =
                      'https://ui-avatars.com/api/?name=User&background=e0e7ff&color=3730a3&size=400';
                  "
                />

                <div
                  class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-slate-900/20 to-transparent"
                ></div>

                <span
                  class="absolute left-3.5 top-3.5 inline-flex items-center gap-1.5 rounded-full border border-white/70 bg-white/90 px-3 py-1.5 text-[11px] font-bold text-emerald-700 shadow-sm backdrop-blur"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                  Registered
                </span>

                <span
                  class="absolute bottom-3.5 right-3.5 flex h-9 w-9 items-center justify-center rounded-xl border border-white/50 bg-white/85 text-sm text-slate-600 shadow-sm backdrop-blur"
                >
                  <i class="fa-regular fa-id-card"></i>
                </span>
              </div>

              <!-- Details -->
              <div class="p-5">
                <div class="mb-4">
                  <p
                    class="mb-1 text-[10px] font-bold uppercase tracking-[0.16em] text-blue-600"
                  >
                    User profile
                  </p>

                  <h3
                    class="truncate text-lg font-extrabold tracking-tight text-slate-900"
                    title="<%= user.name || '' %>"
                  >
                    <%= user.name || 'Unnamed User' %>
                  </h3>

                  <div
                    class="mt-2 flex min-w-0 items-center gap-2 text-sm text-slate-500"
                  >
                    <i
                      class="fa-regular fa-envelope w-4 shrink-0 text-slate-400"
                    ></i>
                    <span class="truncate" title="<%= user.email || '' %>">
                      <%= user.email || 'No email provided' %>
                    </span>
                  </div>
                </div>

                <div
                  class="mb-4 flex items-center justify-between border-t border-slate-100 pt-3"
                >
                  <span class="text-xs font-medium text-slate-400"
                    >Account status</span
                  >
                  <span
                    class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-600"
                  >
                    <i class="fa-solid fa-circle-check"></i>
                    Available
                  </span>
                </div>

                <!-- Actions -->
                <div class="grid grid-cols-2 gap-2.5">
                  <a
                    href="/edit-user/<%= user._id %>"
                    class="soft-button inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-bold text-slate-600 hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700"
                  >
                    <i class="fa-solid fa-pen-to-square text-xs"></i>
                    Edit profile
                  </a>

                  <form
                    action="/delete-user/<%= user._id %>"
                    method="POST"
                    onsubmit="
                      return confirm(
                        'Are you sure you want to delete this user?',
                      );
                    "
                  >
                    <button
                      type="submit"
                      class="soft-button inline-flex w-full items-center justify-center gap-2 rounded-xl border border-rose-100 bg-rose-50/70 px-3 py-2.5 text-sm font-bold text-rose-600 hover:border-rose-200 hover:bg-rose-100"
                    >
                      <i class="fa-regular fa-trash-can text-xs"></i>
                      Delete
                    </button>
                  </form>
                </div>
              </div>
            </article>

            <% }) %>
          </div>

          <!-- Search no-results state -->
          <div id="emptyState" class="hidden py-16 text-center">
            <div
              class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-50 text-blue-500"
            >
              <i class="fa-solid fa-magnifying-glass text-2xl"></i>
            </div>
            <h3 class="mt-5 text-lg font-extrabold text-slate-900">
              No matching users
            </h3>
            <p class="mt-2 text-sm text-slate-500">
              Try a different name or email address.
            </p>
            <button
              id="clearSearch"
              type="button"
              class="mt-4 text-sm font-bold text-blue-600 hover:text-blue-700"
            >
              Clear search
            </button>
          </div>

          <% } else { %>

          <!-- Empty database state -->
          <div class="px-4 py-16 text-center sm:py-20">
            <div
              class="relative mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-gradient-to-br from-blue-100 to-violet-100 text-blue-600"
            >
              <i class="fa-solid fa-users text-3xl"></i>
              <span
                class="absolute -right-2 -top-2 flex h-8 w-8 items-center justify-center rounded-xl border-4 border-white bg-blue-600 text-xs text-white"
              >
                <i class="fa-solid fa-plus"></i>
              </span>
            </div>

            <h3
              class="mt-6 text-xl font-extrabold tracking-tight text-slate-900"
            >
              Your directory starts here
            </h3>
            <p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-slate-500">
              No users have been added yet. Create your first profile to get
              started.
            </p>

            <a
              href="/create-user"
              class="soft-button mt-6 inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-blue-600/20 hover:bg-blue-700"
            >
              <i class="fa-solid fa-plus"></i>
              Create your first user
            </a>
          </div>

          <% } %>
        </div>

        <!-- Bottom bar -->
        <div
          class="flex flex-col gap-2 border-t border-slate-100 bg-slate-50/60 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-7"
        >
          <p class="text-xs text-slate-400">
            <i class="fa-solid fa-lock mr-1.5"></i>
            User directory management
          </p>
          <p class="text-xs font-medium text-slate-400">
            <%= users.length %> total <%= users.length === 1 ? 'user' : 'users'
            %>
          </p>
        </div>
      </section>

      <!-- Footer -->
      <footer
        class="flex flex-col items-center justify-between gap-3 px-2 py-7 text-xs text-slate-400 sm:flex-row"
      >
        <p>
          ©
          <%= new Date().getFullYear() %>
          Nexus Dashboard
        </p>
        <p class="flex items-center gap-2">
          Made for simpler user management
          <i class="fa-solid fa-heart text-rose-400"></i>
        </p>
      </footer>
    </main>

    <!-- Search functionality -->
    <script>
      const searchInput = document.getElementById("userSearch");
      const userCards = document.querySelectorAll(".user-card");
      const emptyState = document.getElementById("emptyState");
      const clearSearch = document.getElementById("clearSearch");

      function filterUsers() {
        const query = searchInput.value.toLowerCase().trim();
        let visibleCount = 0;

        userCards.forEach((card) => {
          const name = (card.dataset.name || "").toLowerCase();
          const email = (card.dataset.email || "").toLowerCase();
          const matches = name.includes(query) || email.includes(query);

          card.classList.toggle("hidden", !matches);

          if (matches) visibleCount++;
        });

        if (emptyState) {
          emptyState.classList.toggle(
            "hidden",
            query === "" || visibleCount > 0,
          );
        }
      }

      searchInput.addEventListener("input", filterUsers);

      if (clearSearch) {
        clearSearch.addEventListener("click", () => {
          searchInput.value = "";
          filterUsers();
          searchInput.focus();
        });
      }
    </script>
  </body>
</html>
